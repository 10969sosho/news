# LLM Configuration
# Choose LLM_PROVIDER: "openai" or "gemini"
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: Gemini (OpenAI compatible endpoint or key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Search API Configuration
# Provider: "tavily" or "duckduckgo" (duckduckgo requires no key)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here

# System ReAct Parameters (based on paper)
CONFIDENCE_THRESHOLD=0.85
MAX_ITERATIONS=5

# Server Port
PORT=8000
HOST=0.0.0.0
